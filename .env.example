# 可选：也可在“设置 → 翻译”中保存。密钥以便携式明文写入程序目录，
# 不会写入项目文件、性能日志或网页输出。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
AZURE_TRANSLATOR_KEY=
OPENAI_COMPATIBLE_API_KEY=

# 仅在绑定非本机地址时使用；未设置密码会在启动终端生成一次性随机值。
# ASMR_DUBBER_UI_USERNAME=asmr
# ASMR_DUBBER_UI_PASSWORD=
# ASMR_DUBBER_MAX_UPLOAD_SIZE=20gb

# 可选 FFmpeg 覆盖。
# ASMR_DUBBER_FFMPEG=/absolute/path/to/linux/ffmpeg

# 下载默认由 mirrors.json 统一控制并优先使用 ModelScope。公开仓库通常不需要 Token。
# MODELSCOPE_API_TOKEN=
# ASMR_DUBBER_LOCAL_CACHE_ROOTS=E:\ASMR-Dubber-Artifact-Cache

# 默认不自动使用 GitHub、Hugging Face、hf-mirror 或海外官方源。
# 只有明确接受相关网络流量时，才为当前进程设置为 1。
# ASMR_DUBBER_ALLOW_EXTERNAL_DOWNLOADS=0
